{
  "manifest_version": 3,
  "name": "Stream Transcript Extractor",
  "version": "0.2.0",
  "description": "Save Microsoft Stream / SharePoint recording and Teams meeting recap transcripts as WebVTT or Markdown, with speaker names preserved.",
  "permissions": ["activeTab", "scripting"],
  "host_permissions": [
    "https://*.sharepoint.com/*",
    "https://*.sharepoint-df.com/*",
    "https://*.microsoftstream.com/*",
    "https://outlook.office.com/*",
    "https://outlook.office365.com/*"
  ],
  "icons": {
    "16": "icons/icon-16.png",
    "32": "icons/icon-32.png",
    "48": "icons/icon-48.png",
    "128": "icons/icon-128.png"
  },
  "action": {
    "default_title": "Extract Stream transcript",
    "default_popup": "popup.html",
    "default_icon": {
      "16": "icons/icon-16.png",
      "32": "icons/icon-32.png",
      "48": "icons/icon-48.png",
      "128": "icons/icon-128.png"
    }
  }
}
